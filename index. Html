
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ALFIGO | Digital Portfolio</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700&display=swap');

:root {
    --bg: #050812;
    --card: #101827;
    --blue: #35A7FF;
    --blue2: #0066FF;
    --white: #FFFFFF;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: white;
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

#loader {
    position: fixed;
    inset: 0;
    background: #050812;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: .6s;
}

.loader-text {
    color: var(--blue);
    font-family: Orbitron;
    letter-spacing: 5px;
    animation: pulse 1s infinite alternate;
}

@keyframes pulse {
    to { opacity: .3; }
}

#particles {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
}

header {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(5,8,18,.9);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid #183454;
    z-index: 100;
}

.logo {
    font-family: Orbitron;
    font-size: 22px;
    font-weight: 800;
    color: var(--blue);
}

nav a {
    color: #ddd;
    text-decoration: none;
    margin-left: 18px;
    font-size: 12px;
    transition: .3s;
}

nav a:hover {
    color: var(--blue);
}

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 60px;
    position: relative;
    background: radial-gradient(circle at center,#10213d,#050812 70%);
}

.glow {
    position: absolute;
    width: 250px;
    height: 250px;
    background: var(--blue2);
    filter: blur(130px);
    opacity: .25;
    animation: floating 5s infinite alternate;
}

@keyframes floating {
    to { transform: translate(60px,-40px) scale(1.3); }
}

.hero-content {
    position: relative;
    z-index: 2;
    animation: appear 1.2s ease;
}

@keyframes appear {
    from { opacity: 0; transform: translateY(35px); }
    to { opacity: 1; transform: translateY(0); }
}

.tag {
    display: inline-block;
    border: 1px solid #24558a;
    padding: 9px 20px;
    border-radius: 30px;
    color: var(--blue);
    letter-spacing: 3px;
    font-size: 10px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: clamp(45px,9vw,85px);
    line-height: 1.2;
}

.gradient {
    background: linear-gradient(90deg,#35A7FF,#0066FF,#9BD8FF);
    background-size: 200%;
    -webkit-background-clip: text;
    color: transparent;
    animation: gradient 4s infinite alternate;
}

@keyframes gradient {
    to { background-position: 100%; }
}

.typing {
    margin: 25px 0;
    color: #bbb;
    font-size: 18px;
    min-height: 30px;
}

#typed {
    color: var(--blue);
}

.description {
    max-width: 550px;
    margin: auto;
    color: #a9b8cc;
    font-size: 14px;
    line-height: 1.9;
}

.buttons {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 13px 25px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: .3s;
}

.primary {
    background: linear-gradient(90deg,#35A7FF,#0066FF);
    color: white;
}

.secondary {
    border: 1px solid var(--blue);
    color: white;
}

.btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 25px #35A7FF88;
}

.clock {
    margin-top: 30px;
    color: #8CCBFF;
    font-size: 12px;
    letter-spacing: 2px;
}

section {
    padding: 90px 9%;
}

.title {
    text-align: center;
    margin-bottom: 45px;
}

.title h2 {
    font-family: Orbitron;
    font-size: 28px;
}

.title span {
    color: var(--blue);
}

.title p {
    color: #8fa5c0;
    font-size: 13px;
    margin-top: 10px;
}

.about-box {
    max-width: 800px;
    margin: auto;
    background: rgba(16,24,39,.85);
    border: 1px solid #24446b;
    padding: 35px;
    border-radius: 20px;
    text-align: center;
    transition: .4s;
}

.about-box:hover {
    transform: translateY(-7px);
    border-color: var(--blue);
    box-shadow: 0 0 30px #35A7FF22;
}

.about-box p {
    color: #c0cee0;
    font-size: 14px;
    line-height: 2;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(200px,1fr));
    gap: 20px;
}

.card {
    background: linear-gradient(145deg,#142238,#0b1220);
    border: 1px solid #263c59;
    padding: 30px 22px;
    border-radius: 18px;
    transition: .4s;
}

.card:hover {
    transform: translateY(-10px);
    border-color: var(--blue);
    box-shadow: 0 10px 35px #35A7FF25;
}

.number {
    font-family: Orbitron;
    font-size: 27px;
    color: var(--blue);
    margin-bottom: 15px;
}

.card h3 {
    margin-bottom: 12px;
    color: white;
}

.card p {
    font-size: 12px;
    line-height: 1.8;
    color: #a9b8cc;
}

.contact-box {
    text-align: center;
    padding: 45px 20px;
    background: linear-gradient(135deg,#142238,#101827);
    border: 1px solid #284b75;
    border-radius: 25px;
}

.contact-box p {
    color: #a9b8cc;
    margin: 15px 0;
}

.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: .8s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

.top {
    position: fixed;
    bottom: 25px;
    right: 22px;
    width: 45px;
    height: 45px;
    border: none;
    border-radius: 50%;
    background: var(--blue2);
    color: white;
    font-size: 20px;
    cursor: pointer;
    display: none;
    z-index: 90;
}

.top.show {
    display: block;
}

footer {
    text-align: center;
    padding: 25px;
    border-top: 1px solid #1b3555;
    color: #8ca0ba;
    font-size: 12px;
}

@media(max-width:600px) {
    header {
        padding: 16px 4%;
    }

    .logo {
        font-size: 16px;
    }

    nav a {
        margin-left: 7px;
        font-size: 9px;
    }

    section {
        padding: 75px 6%;
    }

    .about-box {
        padding: 25px;
    }

    .title h2 {
        font-size: 23px;
    }
}
</style>
</head>

<body>

<div id="loader">
    <div class="loader-text">ALFIGO SYSTEM</div>
</div>

<canvas id="particles"></canvas>

<header>
    <div class="logo">ALFIGO.</div>
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<!-- HOME -->
<div class="hero" id="home">
    <div class="glow"></div>

    <div class="hero-content">
        <div class="tag">WELCOME TO MY DIGITAL WORLD</div>

        <h1>
            HELLO,<br>
            I'M <span class="gradient">ALFIGO.</span>
        </h1>

        <div class="typing">
            I'm a <span id="typed"></span>|
        </div>

        <p class="description">
            Exploring creativity, technology and digital innovation.
            Turning ideas into something extraordinary.
        </p>

        <div class="buttons">
            <a href="#about" class="btn primary">Explore More ↗</a>
            <a href="#contact" class="btn secondary">Contact Me</a>
        </div>

        <div class="clock">
            LOCAL TIME: <span id="clock">00:00:00</span>
        </div>
    </div>
</div>

<!-- ABOUT -->
<section id="about" class="reveal">
    <div class="title">
        <h2>ABOUT <span>ME</span></h2>
        <p>A little introduction about myself</p>
    </div>

    <div class="about-box">
        <p>
            Halo! Saya Alfigo. Saya memiliki ketertarikan
            pada teknologi digital, multimedia, desain kreatif,
            dan pengembangan website. Saya senang mengeksplorasi
            ide baru dan mengembangkan kemampuan melalui
            berbagai pengalaman serta proyek digital.
        </p>
    </div>
</section>

<!-- SKILLS -->
<section id="skills" class="reveal">
    <div class="title">
        <h2>MY <span>INTERESTS</span></h2>
        <p>Things I love to explore</p>
    </div>

    <div class="grid">
        <div class="card">
            <div class="number">01</div>
            <h3>Web Development</h3>
            <p>Exploring HTML, CSS, JavaScript and modern websites.</p>
        </div>

        <div class="card">
            <div class="number">02</div>
            <h3>Multimedia</h3>
            <p>Creating digital media and creative content.</p>
        </div>

        <div class="card">
            <div class="number">03</div>
            <h3>Technology</h3>
            <p>Discovering new technologies and digital innovations.</p>
        </div>

        <div class="card">
            <div class="number">04</div>
            <h3>Creative Design</h3>
            <p>Turning ideas into attractive visual experiences.</p>
        </div>
    </div>
</section>

<!-- CONTACT -->
<section id="contact" class="reveal">
    <div class="contact-box">
        <div class="title">
            <h2>LET'S <span>CONNECT</span></h2>
            <p>Every great idea starts with curiosity.</p>
        </div>

        <a href="#home" class="btn primary">Back To Top ↑</a>
    </div>
</section>

<footer>
    © 2026 ALFIGO. Designed with creativity.
</footer>

<button class="top" id="top"
onclick="window.scrollTo({top:0,behavior:'smooth'})">
↑
</button>

<script>
// LOADING
window.addEventListener("load", function() {
    setTimeout(function() {
        document.getElementById("loader").style.opacity = "0";

        setTimeout(function() {
            document.getElementById("loader").style.display = "none";
        }, 600);
    }, 800);
});

// TYPING EFFECT
const words = [
    "Digital Enthusiast",
    "Creative Thinker",
    "Multimedia Student",
    "Web Explorer"
];

let wi = 0;
let ci = 0;
let deleting = false;

function typing() {
    const element = document.getElementById("typed");
    const current = words[wi];

    element.textContent = current.substring(0,ci);

    if (!deleting) {
        ci++;

        if (ci > current.length) {
            deleting = true;
            setTimeout(typing,1200);
            return;
        }
    } else {
        ci--;

        if (ci < 0) {
            ci = 0;
            deleting = false;
            wi = (wi + 1) % words.length;
        }
    }

    setTimeout(typing,deleting ? 45 : 90);
}

typing();

// DIGITAL CLOCK
function updateClock() {
    document.getElementById("clock").textContent =
    new Date().toLocaleTimeString("id-ID");
}

updateClock();
setInterval(updateClock,1000);

// SCROLL ANIMATION
function reveal() {
    document.querySelectorAll(".reveal").forEach(function(el) {
        if (el.getBoundingClientRect().top < window.innerHeight - 80) {
            el.classList.add("active");
        }
    });

    document.getElementById("top").classList.toggle(
        "show", window.scrollY > 400
    );
}

window.addEventListener("scroll",reveal);
reveal();

// PARTICLE BACKGROUND
const canvas = document.getElementById("particles");
const ctx = canvas.getContext("2d");

let particles = [];

function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    particles = [];

    for (let i = 0; i < 55; i++) {
        particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 2 + .5,
            dx: (Math.random() - .5) * .5,
            dy: (Math.random() - .5) * .5
        });
    }
}

function animateParticles() {
    ctx.clearRect(0,0,canvas.width,canvas.height);

    particles.forEach(function(p) {
        p.x += p.dx;
        p.y += p.dy;

        if (p.x < 0 || p.x > canvas.width) p.dx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.dy *= -1;

        ctx.beginPath();
        ctx.arc(p.x,p.y,p.r,0,Math.PI * 2);
        ctx.fillStyle = "#35A7FF";
        ctx.globalAlpha = .65;
        ctx.fill();
    });

    ctx.globalAlpha = 1;
    requestAnimationFrame(animateParticles);
}

window.addEventListener("resize",resizeCanvas);
resizeCanvas();
animateParticles();

</script>

</body>
</html>
